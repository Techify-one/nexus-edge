{
  "name": "nexus-edge",
  "version": "1.1.0-beta.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:frontend && pnpm build:installer && pnpm build:plugins && pnpm --filter @app/plugin-template build",
    "build:frontend": "pnpm --filter @app/frontend build",
    "build:installer": "pnpm --filter @app/installer-frontend build && pnpm --filter @app/installer-worker build",
    "build:plugins": "pnpm --filter @app/plugin-crm build && node --import tsx scripts/package-plugin.ts crm && pnpm --filter @app/plugin-meta-ads build && node --import tsx scripts/package-plugin.ts meta_ads && pnpm --filter @app/plugin-soletrando build && node --import tsx scripts/package-plugin.ts soletrando && pnpm --filter @app/plugin-meeting-recorder build && node --import tsx scripts/package-plugin.ts meeting_recorder",
    "verify:artifacts": "node --import tsx scripts/verify-artifacts.ts",
    "typecheck": "tsc -b --pretty false && tsc -p installer/worker/tests/tsconfig.json --noEmit --pretty false",
    "test": "vitest run && pnpm test:installer",
    "test:installer": "pnpm --dir installer/worker exec vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:matrix": "node --import tsx scripts/test-database-matrix.ts",
    "test:meeting-recorder:api": "node --import tsx scripts/test-meeting-recorder-api.ts",
    "lint": "tsc -b --pretty false",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @app/frontend dev",
    "deploy:core": "node --import tsx scripts/deploy-core.ts",
    "deploy:direct": "node scripts/direct-deploy.mjs",
    "deploy": "pnpm deploy:core",
    "provision:d1": "node --import tsx scripts/provision.ts d1",
    "provision:postgres": "node --import tsx scripts/provision.ts postgres",
    "preflight": "node --import tsx scripts/preflight.ts",
    "verify:bundle": "node --import tsx scripts/verify-bundles.ts",
    "openapi:check": "node --import tsx scripts/check-openapi.ts",
    "cf-typegen": "wrangler types --config workers/core/wrangler.jsonc workers/core/worker-configuration.d.ts",
    "installer:cf-typegen": "pnpm --filter @app/installer-worker cf-typegen",
    "installer:release:build": "pnpm build:frontend && node --import tsx scripts/build-installer-release.ts",
    "installer:release:publish": "node --import tsx scripts/publish-installer-release.ts",
    "installer:release:publish-objects": "INSTALLER_RELEASE_PUBLISH_MODE=objects node --import tsx scripts/publish-installer-release.ts",
    "installer:release:promote": "INSTALLER_RELEASE_PUBLISH_MODE=promote node --import tsx scripts/publish-installer-release.ts",
    "core:update:release:build": "pnpm build:frontend && node --import tsx scripts/build-installer-release.ts && node --import tsx scripts/package-core-update-release.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.1",
    "@casl/ability": "7.0.1",
    "@casl/react": "7.0.1",
    "@hono/zod-openapi": "1.6.1",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@scalar/hono-api-reference": "0.11.16",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "hono": "4.13.3",
    "lucide-react": "1.33.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-router-dom": "7.18.2",
    "semver": "7.8.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@app/installer-release-schema": "workspace:*",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
