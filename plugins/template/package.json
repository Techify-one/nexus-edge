{
  "name": "@app/plugin-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc && pnpm build:frontend",
    "build:frontend": "esbuild frontend/entry.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/frontend/entry.js && esbuild frontend/styles.css --bundle --outfile=dist/frontend/styles.css",
    "package": "nexus-plugin-package .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --config wrangler.jsonc"
  },
  "dependencies": {
    "@nexus/plugin-sdk": "workspace:*",
    "hono": "4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "wrangler": "4.125.0"
  }
}
