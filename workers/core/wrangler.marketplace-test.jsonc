{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-edge-marketplace-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "vars": {
    "APP_VERSION": "1.1.0-beta.8",
    "CORE_UPDATE_PUBLIC_KEY": "MCowBQYDK2VwAyEAxuOKnkDa5oHc4zGhCxV6GIUU6LhZ7bStR3CgoS9adGo=",
    "APP_INSTALLATION_ID": "install_marketplace_test_14fba1f8103248daadaf2c95ac5e0f7f",
    "DATABASE_PROVIDER": "d1",
    "BETTER_AUTH_URL": "https://nexus-edge-marketplace-test.francisconeto.workers.dev",
    "TRUSTED_ORIGINS": "https://nexus-edge-marketplace-test.francisconeto.workers.dev",
    "CORE_WORKER_NAME": "nexus-edge-marketplace-test",
    "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000000",
    "WEBHOOK_ALLOWED_DOMAINS": "",
    "API_RATE_LIMIT_MAX": "120",
    "API_RATE_LIMIT_WINDOW_SECONDS": "60",
    "PLUGIN_COMPATIBILITY_FLAGS": "nodejs_compat",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-edge-marketplace-test-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/d1",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "nexus-edge-marketplace-test-webhooks",
      },
    ],
    "consumers": [
      {
        "queue": "nexus-edge-marketplace-test-webhooks",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "nexus-edge-marketplace-test-webhooks-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
