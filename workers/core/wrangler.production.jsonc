{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "modular-workers-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hub.francisconeto.net.br",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "vars": {
    "APP_VERSION": "1.1.0-beta.6",
    "CORE_UPDATE_PUBLIC_KEY": "MCowBQYDK2VwAyEAxuOKnkDa5oHc4zGhCxV6GIUU6LhZ7bStR3CgoS9adGo=",
    "APP_INSTALLATION_ID": "install_41d0f93d4e5c41b0be14f175aed651bf",
    "DATABASE_PROVIDER": "d1",
    "BETTER_AUTH_URL": "https://hub.francisconeto.net.br",
    "TRUSTED_ORIGINS": "https://hub.francisconeto.net.br",
    "CORE_WORKER_NAME": "modular-workers-core",
    "D1_DATABASE_ID": "4f21aded-d6db-4aa6-8c46-15ba7e6b7e0c",
    "WEBHOOK_ALLOWED_DOMAINS": "",
    "API_RATE_LIMIT_MAX": "120",
    "API_RATE_LIMIT_WINDOW_SECONDS": "60",
    "PLUGIN_COMPATIBILITY_FLAGS": "nodejs_compat",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-edge-hub-db",
      "database_id": "4f21aded-d6db-4aa6-8c46-15ba7e6b7e0c",
      "migrations_dir": "migrations/d1",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_QUEUE", "queue": "modular-workers-webhooks" },
    ],
    "consumers": [
      {
        "queue": "modular-workers-webhooks",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "modular-workers-webhooks-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
