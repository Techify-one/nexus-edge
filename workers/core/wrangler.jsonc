{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-edge-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "WEBHOOK_ENCRYPTION_KEY"],
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "vars": {
    "APP_VERSION": "1.1.0-beta.4",
    "CORE_UPDATE_PUBLIC_KEY": "MCowBQYDK2VwAyEAxuOKnkDa5oHc4zGhCxV6GIUU6LhZ7bStR3CgoS9adGo=",
    "APP_INSTALLATION_ID": "install_d4bb8d963aad4f649f2cff7c5550bf80",
    "DATABASE_PROVIDER": "d1",
    "BETTER_AUTH_URL": "https://nexus-edge-core.francisconeto.workers.dev",
    "TRUSTED_ORIGINS": "https://nexus-edge-core.francisconeto.workers.dev",
    "CORE_WORKER_NAME": "nexus-edge-core",
    "D1_DATABASE_ID": "81008d73-8bfe-4d9d-87f2-2313ad8d5ce0",
    "WEBHOOK_ALLOWED_DOMAINS": "",
    "API_RATE_LIMIT_MAX": "120",
    "API_RATE_LIMIT_WINDOW_SECONDS": "60",
    "PLUGIN_COMPATIBILITY_FLAGS": "nodejs_compat",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-edge-db",
      "database_id": "81008d73-8bfe-4d9d-87f2-2313ad8d5ce0",
      "migrations_dir": "migrations/d1",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_QUEUE", "queue": "nexus-edge-webhooks" },
    ],
    "consumers": [
      {
        "queue": "nexus-edge-webhooks",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "nexus-edge-webhooks-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
