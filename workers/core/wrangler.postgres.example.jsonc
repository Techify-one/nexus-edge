{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-edge-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "vars": {
    "APP_VERSION": "1.1.0-beta.6",
    "CORE_UPDATE_PUBLIC_KEY": "MCowBQYDK2VwAyEAxuOKnkDa5oHc4zGhCxV6GIUU6LhZ7bStR3CgoS9adGo=",
    "APP_INSTALLATION_ID": "set-by-provision-command",
    "DATABASE_PROVIDER": "postgres",
    "BETTER_AUTH_URL": "https://nexus-edge.example.com",
    "TRUSTED_ORIGINS": "https://nexus-edge.example.com",
    "CORE_WORKER_NAME": "nexus-edge-core",
    "HYPERDRIVE_ID": "replace-with-hyperdrive-id",
    "WEBHOOK_ALLOWED_DOMAINS": "",
    "API_RATE_LIMIT_MAX": "120",
    "API_RATE_LIMIT_WINDOW_SECONDS": "60",
    "PLUGIN_COMPATIBILITY_FLAGS": "nodejs_compat",
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "replace-with-hyperdrive-id" },
  ],
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_QUEUE", "queue": "nexus-edge-webhooks" },
    ],
    "consumers": [
      {
        "queue": "nexus-edge-webhooks",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "nexus-edge-webhooks-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
